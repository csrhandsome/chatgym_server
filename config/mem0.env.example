# Mem0 OSS runs in this Bun backend. No hosted Mem0 API key is needed.
MEM0_TELEMETRY=false
MEM0_QDRANT_URL=http://127.0.0.1:26333
MEM0_QDRANT_PORT=26333
MEM0_COLLECTION=chatgym_memories_v1
MEM0_DATA_DIR=.data/mem0
AUTH_DB_PATH=.data/users.sqlite

# Extraction LLM: falls back to AI_PROVIDER_API_KEY / AI_PROVIDER_BASE_URL.
# Set the actual model ID supported by your provider; no secrets in this file.
MEM0_LLM_MODEL=Pro/zai-org/GLM-5
# MEM0_LLM_BASE_URL=https://api.siliconflow.cn/v1
# MEM0_LLM_API_KEY=fill-only-in-local-env
MEM0_LLM_TIMEOUT_MS=60000

# Embedding is independent of the planning/VLM model.
# Verify the actual embedding length before selecting a collection/dimension.
MEM0_EMBEDDING_MODEL=BAAI/bge-m3
MEM0_EMBEDDING_DIMS=1024
# Defaults to the LLM endpoint/key; override for a separate service.
# MEM0_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# MEM0_EMBEDDING_API_KEY=fill-only-in-local-env
# Only enable for providers supporting OpenAI's optional dimensions field.
MEM0_EMBEDDING_SEND_DIMS=false

# Optional Qdrant secret (the local starter forwards it to Qdrant).
# MEM0_QDRANT_API_KEY=fill-only-in-local-env
