{
  "name": "chatgym_server",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "test": "bun test",
    "test:api": "bun test tests/api",
    "test:api:real": "RUN_REAL_MODEL_TEST=1 bun run tests/api/real-model-smoke.ts",
    "test:api:real:daily": "RUN_REAL_MODEL_TEST=1 bun run tests/api/real-daily-smoke.ts",
    "test:perf": "RUN_PERFORMANCE_TESTS=1 bun test src/agent/shared/tests/performance.test.ts",
    "dev": "bun run --watch index.ts",
    "start": "bun run index.ts",
    "qdrant:start": "bun run scripts/start-qdrant-local.ts",
    "test:mem0:native": "bun run test:mem0:integration",
    "typecheck": "bunx tsc --noEmit",
    "test:mem0": "bun test tests/mem0-adapter.test.ts tests/mem0-migration.test.ts src/agent/shared/tests/workout-memory.test.ts",
    "test:mem0:integration": "RUN_MEM0_INTEGRATION=1 bun test tests/mem0-qdrant.integration.test.ts",
    "mem0:verify-provider": "bun scripts/verify-mem0-provider.ts",
    "mem0:verify-memory": "bun scripts/verify-mem0-memory.ts",
    "mem0:migrate": "bun scripts/migrate-workout-memory.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.38",
    "@elysiajs/jwt": "^1.4.1",
    "@qdrant/js-client-rest": "1.18.0",
    "ai": "^6.0.141",
    "elysia": "^1.4.28",
    "mem0ai": "3.3.1"
  }
}
