# ChatGym server — secret-free template. Copy to `.env` and fill in real keys.
# `.env` is gitignored; never commit real keys.

# --- LLM provider (OpenAI-compatible; default in code is SiliconFlow) ---
AI_PROVIDER_NAME=deepseek
AI_PROVIDER_BASE_URL=https://api.deepseek.com/v1
AI_PROVIDER_API_KEY=fill-only-in-local-env
# DeepSeek models reason (chain-of-thought) by default, which dominates planning
# latency. Set true to inject `thinking:{type:"disabled"}` on every request.
AI_PROVIDER_DISABLE_THINKING=true
GYM_AGENT_MODEL=deepseek-flash
GYM_VLM_MODEL=deepseek-flash

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Mem0 OSS (see config/mem0.env.example for details) ---
MEM0_TELEMETRY=false
MEM0_QDRANT_URL=http://127.0.0.1:26333
MEM0_QDRANT_PORT=26333
MEM0_COLLECTION=chatgym_memories_v1
MEM0_DATA_DIR=.data/mem0
AUTH_DB_PATH=.data/users.sqlite

# Extraction LLM: falls back to AI_PROVIDER_API_KEY / AI_PROVIDER_BASE_URL.
MEM0_LLM_MODEL=deepseek-flash
# MEM0_LLM_BASE_URL=https://api.deepseek.com/v1
# MEM0_LLM_API_KEY=fill-only-in-local-env
MEM0_LLM_TIMEOUT_MS=60000

# Embedding is independent of the planning/VLM model (DeepSeek has none).
MEM0_EMBEDDING_MODEL=text-embedding-v4
MEM0_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEM0_EMBEDDING_API_KEY=fill-only-in-local-env
MEM0_EMBEDDING_DIMS=1024
# Only enable for providers supporting OpenAI's optional dimensions field.
MEM0_EMBEDDING_SEND_DIMS=false

# Optional Qdrant secret (use the SAME value for compose and the backend).
# MEM0_QDRANT_API_KEY=fill-only-in-local-env
